{
  "name": "sigcore-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "node -e \"if(process.env.RAILWAY_ENVIRONMENT==='prod'){try{require('child_process').execSync('npx --yes @fixprompt/cli deploy-start --source sigcore-api-prod --key \\\"'+(process.env.FIXPROMPT_KEY||'')+('\\\" --status success'),{stdio:'inherit'})}catch(e){console.warn('[fixprompt] deploy marker failed:',e.message)}}\""
  },
  "dependencies": {
    "@fixprompt/node": "^0.0.2",
    "@geos/loghub-client": "github:goscha01/geos-loghub-client"
  }
}