PORT=3002
SERVICE_API_KEY=your-secret-api-key
SIGCORE_API_URL=http://localhost:3001/api
SIGCORE_WEBHOOK_KEY=your-webhook-shared-secret

# TelePorter (the bot infra layer — owned by another agent)
# Two distinct secrets per TelePorter contract:
#   TELEPORTER_SERVICE_KEY        — outbound auth header (X-TelePorter-Service-Key)
#   TELEPORTER_CALLBACK_HMAC_SECRET — per-integrator HMAC key for verifying
#                                     inbound /webhooks/teleporter callbacks
TELEPORTER_BASE_URL=https://teleporter-publisher-api.example/api/v1
TELEPORTER_SERVICE_KEY=your-teleporter-outbound-service-key
TELEPORTER_CALLBACK_HMAC_SECRET=your-per-integrator-callback-hmac-secret
TELEPORTER_INTEGRATOR_ID=sigcore-hirefunnel
# Public URL TelePorter will hit back for message callbacks
TELEPORTER_CALLBACK_URL=http://localhost:3002/webhooks/teleporter

# Verify-result cache
TELEGRAM_VERIFY_CACHE_TTL_MS=3600000
TELEGRAM_VERIFY_CACHE_MAX_ENTRIES=5000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
