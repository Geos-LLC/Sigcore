PORT=3003

# Service-to-service auth: callers must send this in `x-api-key`
SERVICE_API_KEY=your-secret-api-key

# Sigcore ingestion (where this connector forwards normalized events)
SIGCORE_API_URL=http://localhost:3002/api
SIGCORE_WEBHOOK_KEY=your-webhook-shared-secret

# Credential encryption key (32 bytes, base64-encoded). Used to encrypt bot
# tokens and MTProto sessions at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TELEGRAM_ENCRYPTION_KEY=

# Optional secret token Telegram includes in the X-Telegram-Bot-Api-Secret-Token
# header (set when calling setWebhook). When present, the connector rejects
# webhook deliveries that do not match.
TELEGRAM_WEBHOOK_SECRET=

# CORS — only needed if a browser calls this service directly
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Public base URL where Telegram should POST webhook events
PUBLIC_BASE_URL=https://your-telegram-connector.example.com