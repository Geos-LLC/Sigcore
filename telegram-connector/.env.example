# --- Service ---
PORT=4002
LOG_LEVEL=info

# --- Shared infrastructure ---
# Postgres is used for:
#   - Telegram account credentials (encrypted)
#   - Durable inbound events (pending → processing → sent / dead)
#   - Outbound idempotency cache
# This is the same Postgres instance Sigcore uses; the connector has its
# own tables but uses the shared DB so durable state survives restarts and
# is visible to operational tooling.
DATABASE_URL=postgres://sigcore:sigcore@localhost:5432/sigcore

# --- Auth / encryption ---
# 32-byte hex key (64 chars) — required. Encrypts bot tokens and any
# future GramJS sessions at rest. The connector refuses to register
# accounts if this is missing.
TELEGRAM_ENCRYPTION_KEY=

# Internal API key required on /api/telegram/accounts/* and
# /api/telegram/messages/send. Sigcore + TelePorter pass this as x-api-key.
TELEGRAM_CONNECTOR_API_KEY=

# --- Sigcore ingestion ---
# Generic provider-ingestion endpoint on Sigcore. The connector posts
# normalized payloads here; Sigcore owns persistence and event fan-out.
SIGCORE_API_URL=http://localhost:3000
SIGCORE_WEBHOOK_KEY=

# --- Feature flags ---
# Controls whether TelePorter consumes Telegram conversations from Sigcore
# (when true) vs the direct GramJS path (when false / unset). Sigcore reads
# this same flag to decide whether to fan out telegram.* webhook events,
# so flipping it everywhere switches both producer and consumer at once.
TELEPORTER_SIGCORE_TELEGRAM_ENABLED=false

# MTProto / GramJS user-session transport. Disabled for MVP. When false
# the connector refuses to send via MTProto and returns mtproto_disabled.
TELEGRAM_MTPROTO_ENABLED=false

# --- Telegram webhook source verification ---
# Optional shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# --- Drainer ---
TELEGRAM_DRAINER_INTERVAL_MS=2000
TELEGRAM_DRAINER_BATCH_SIZE=20
TELEGRAM_DRAINER_MAX_ATTEMPTS=8
