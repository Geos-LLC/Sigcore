# telegram-connector service env

# HTTP
PORT=3002
ALLOWED_ORIGINS=*

# Internal auth for control endpoints (account connect/status/list)
TELEGRAM_CONNECTOR_API_KEY=

# At-rest encryption (REQUIRED to register accounts)
# 32-byte key, base64 encoded.  e.g.  openssl rand -base64 32
TELEGRAM_ENCRYPTION_KEY=

# Sigcore ingestion target — drainer posts normalized events here
SIGCORE_API_URL=
# Webhook key for the connector → Sigcore call (matches SIGCORE_WEBHOOK_KEY on the Sigcore side)
SIGCORE_WEBHOOK_KEY=

# Optional Telegram secret-token header verified on inbound webhooks.
# When unset, the tenant-scoped URL path is the only validation.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Drainer tuning
TELEGRAM_DRAINER_INTERVAL_MS=2000
TELEGRAM_DRAINER_BATCH=20
TELEGRAM_DRAINER_MAX_ATTEMPTS=8

# Feature flag — MTProto / GramJS user-session transport.
# MUST be left false in MVP.  TelePorter keeps owning its MTProto sessions.
# Setting this to true exposes a stubbed transport that refuses to send.
TELEGRAM_MTPROTO_ENABLED=false

# Data dirs (created on boot)
TELEGRAM_DATA_DIR=./data
